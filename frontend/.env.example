VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
# Alternative supported by the app:
# VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key

# Google Gemini for the For U chat.
VITE_GEMINI_API_KEY=your-gemini-api-key

# Server-only. Never expose this in frontend code.
# Vercel uses this from api/whatsapp/webhook.ts.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Twilio WhatsApp Sandbox display number for the settings page.
VITE_TWILIO_WHATSAPP_SANDBOX_NUMBER=+1 415 523 8886

# SHA-256 hash for the temporary private Studio password.
# Do not put the plain password in frontend env vars.
VITE_STUDIO_ACCESS_HASH=5f1873fa04286dd1ce22cf0eedbc3467af3a84ac87f09a626b00a275ecda0ec2

# Public WhatsApp number for booking confirmations. Use country code, no plus sign.
# Example: 51999999999
VITE_FORU_WHATSAPP_NUMBER=51920728979
